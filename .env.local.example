# انسخ هذا الملف إلى .env.local واملأ القيم من إعدادات مشروعك في Supabase
# (Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (Project Settings → API → service_role) — سرّي، للخادم فقط.
# لازم للميزات العامة بلا تسجيل دخول: بوابة الاكتشاف العامة (/discovery/{token})،
# ودجت الدعم، وروابط المشاركة، وويبهوك تيليجرام. اضبطه في متغيّرات البيئة على Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# Google Gemini (تحليل الاكتشاف + استخراج الاجتماعات + ...)
# ============================================================
# مفتاح واحد يكفي للتشغيل. لتفادي حد الحصة المجانية (Free Tier، ~20
# طلب/يوم لكل مشروع Google Cloud) بشكل دائم ومجاني: أنشئ عدة مشاريع
# مجانية على aistudio.google.com (كل مشروع له حصته المستقلة)، وحطّ
# مفاتيحهم هنا بإحدى الطريقتين (تقدر تخلط الاتنين):
#   1) مفصولين بفاصلة في نفس المتغيّر:
#        GEMINI_API_KEY=key1,key2,key3
#   2) أو كل مفتاح في متغيّر منفصل (GEMINI_API_KEY_2 لغاية _10):
#        GEMINI_API_KEY=key1
#        GEMINI_API_KEY_2=key2
#        GEMINI_API_KEY_3=key3
# النظام بيدوّر تلقائيًا: لو مفتاح ضرب حد الحصة يجرّب اللي بعده على طول
# بدون أي انتظار — يعني كل مفتاح إضافي = مضاعفة السقف اليومي مجانًا.
GEMINI_API_KEY=your-gemini-api-key-here

# مفتاح مدفوع (Paid Tier / Billing مفعّل على مشروع Google Cloud) —
# حصته اليومية أعلى بكتير من الـ Free Tier. لو حاطط مفتاح هنا، النظام
# بيجرّبه هو الأول قبل أي مفتاح من GEMINI_API_KEY فوق (نفس صيغة الفصل
# بالفاصلة لو عندك أكتر من مفتاح مدفوع).
GEMINI_API_KEY_PAID=your-paid-gemini-api-key-here

# ============================================================
# WhatsApp Communication Engine (Phase 3) — اختياري حسب المزوّد المختار
# لو المزوّد "noop" (الافتراضي) مش هتحتاج أي من دي.
# ============================================================

# Meta WhatsApp Cloud API (المزوّد الموصى به)
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=

# Twilio (كبديل)
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=

# سرّ نقطة تشغيل مسح التذكيرات (/api/cron/whatsapp-reminders)
# مطلوب حتى لو ما ضبطتش Vercel Cron — الـ endpoint بيرفض بدونه.
CRON_SECRET=

# --- Migration Intelligence Platform ---
# مفتاح تشفير أسرار مصادر الترحيل (AES-256-GCM). ولّد مفتاحًا قويًا:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# مطلوب فقط عند تسجيل مصادر تحمل بيانات اعتماد (اتصال حيّ). بدونه، رفع
# الملفات ورفع الـSchema يعملان دون أي سرّ.
MIGRATION_SECRET_KEY=
